{
  "name": "@motrix/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Motrix browser extension (Chrome MV3 + Firefox MV3)",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "imports": {
    "#build-variant-plugin": "./buildVariantPlugin.ts",
    "#manifest-config": "./manifest.config.ts"
  },
  "scripts": {
    "check:imports": "node scripts/check-imports.mjs",
    "dev": "vite",
    "dev:firefox": "vite --mode firefox",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/verify-build.mjs chromium",
    "build:chromium": "tsc --noEmit -p tsconfig.json && vite build --mode chromium && node scripts/verify-build.mjs chromium",
    "build:firefox": "tsc --noEmit -p tsconfig.json && vite build --mode firefox && node scripts/verify-build.mjs firefox",
    "build:webstore": "tsc --noEmit -p tsconfig.json && vite build --mode webstore && node scripts/verify-webstore-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check . && pnpm check:imports",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@motrix/mdxp": "^0.6.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.12",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vscode-jsonrpc": "^9.0.2",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/chrome": "^0.2.7",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/webextension-polyfill": "^0.12.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "es-module-lexer": "2.3.2",
    "jsdom": "^30.0.1",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
